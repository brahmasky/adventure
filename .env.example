# Houge configuration — copy to `.env` and fill in.
#   cp .env.example .env
#
# `.env` is gitignored. Real environment variables (e.g. `set -x FOO bar`)
# take precedence over anything in this file.
#
# By default the CLI reads `<cwd>/.env`. To share one file across git
# worktrees, point every worktree at a single absolute path instead:
#   set -x HOUGE_ENV_FILE /Users/pluo/Projects/adventure/.env

# --- Telegram (required for `houge telegram-poll --once`) ---
# Bot token from @BotFather.
HOUGE_TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (e.g. from @userinfobot).
HOUGE_TELEGRAM_USER_ID=

# Numeric chat id. For a 1:1 chat with your bot this equals your user id.
HOUGE_TELEGRAM_CHAT_ID=

# --- Always-on daemon (`houge telegram-poll`, no --once) ---
# Long-poll timeout (s): how long an IDLE Telegram connection is held; a message
# arriving sooner is delivered immediately (not your message latency). Default 30.
# HOUGE_TELEGRAM_LONGPOLL_TIMEOUT_S=30
# Exponential backoff after Telegram errors: base * 2^(failures-1), capped.
# HOUGE_DAEMON_BACKOFF_BASE_MS=1000
# HOUGE_DAEMON_BACKOFF_MAX_MS=60000
# Single-instance lockfile path (a second daemon with the same lock exits).
# HOUGE_DAEMON_LOCK_PATH=houge.daemon.lock

# --- LLM provider chain (powers `/ask`) ---
# Ordered, comma-separated chain with automatic fallback (first success wins;
# unavailable/error/timeout falls through to the next).
# Known providers: pi + agy-cli (hardened single-shot CLIs), kimi-api + gemini-api
# (OpenAI-compatible HTTP). agy-cli/gemini-api are GENERAL-model legs (Gemini Flash)
# so research synthesis doesn't over-produce like the coding-tuned pi/kimi legs and
# blow pi's output cap. Default chain when unset: pi,kimi-api.
# Recommended live chain: pi,agy-cli,kimi-api,gemini-api.
# NOTE: the singular HOUGE_LLM_PROVIDER is IGNORED when this plural is set.
# HOUGE_LLM_PROVIDERS=pi,agy-cli,kimi-api,gemini-api

# Model is configured PER PROVIDER (their model namespaces differ — there is no
# shared global, to avoid feeding e.g. a Moonshot id to pi).
#   pi:         omit to defer to pi's OWN configured provider/model (e.g. kimi-coder).
#               Only set this to make Houge override pi's choice.
# HOUGE_LLM_MODEL_PI=
#   kimi-api:   must be a model your KIMI_API_KEY can access (GET /v1/models).
#               Code fallback if unset: moonshot-v1-auto (stable alias, won't 404).
# HOUGE_LLM_MODEL_KIMI=kimi-k2.7-code-highspeed
#   agy-cli:    one of `agy models` (default "Gemini 3.5 Flash (Low)").
# HOUGE_AGY_MODEL=Gemini 3.5 Flash (Low)
#   gemini-api: a model your GEMINI_API_KEY can access (default gemini-3.5-flash).
# HOUGE_LLM_MODEL_GEMINI=gemini-3.5-flash

# `/ask` system prompt — a projection of Houge's Core Identity (memory/core/houge.md):
# the cheerful, capable 猴哥, inference-only (answers, doesn't act). Override the whole
# prompt here for a different voice/policy. Unset = built-in identity default.
# HOUGE_ASK_SYSTEM_PROMPT=

# Per-provider wall-clock timeouts (ms). The CapabilityRunner's enforced cap is
# DERIVED from these: sum(per-provider timeouts) + 15000 buffer. With the 4-leg
# chain (pi 60000 + agy 60000 + kimi 30000 + gemini 30000) the runner cap is 195000.
# HOUGE_LLM_TIMEOUT_MS=          # fallback for any provider without a specific one
# HOUGE_LLM_TIMEOUT_MS_PI=60000
# HOUGE_LLM_TIMEOUT_MS_KIMI=30000
# HOUGE_LLM_TIMEOUT_MS_AGY=60000
# HOUGE_LLM_TIMEOUT_MS_GEMINI=30000

# --- pi CLI provider ---
# Extra env var NAMES (comma-separated) to pass through to the pi child process.
# The child runs with a minimal allowlist (PATH, HOME, TERM, LANG, USER) — the
# attacker-controlled question never sees the Telegram token or unrelated keys.
# Add the var pi needs for auth here, e.g. the provider API key pi is set up for.
# HOUGE_PI_ENV_PASSTHROUGH=

# --- agy CLI provider (Antigravity / Gemini Flash) ---
# Absolute path to the `agy` binary — REQUIRED for the daemon (restricted PATH),
# like HOUGE_CLAUDE_BIN/HOUGE_CODEX_BIN. On an interactive shell it's on PATH.
# HOUGE_AGY_BIN=/Users/you/.local/bin/agy
# Extra env var NAMES for the agy child (same minimal allowlist as pi). agy normally
# reads its auth from $HOME, so this is rarely needed. The prompt rides argv as one
# discrete element (injection-safe); --dangerously-skip-permissions is never passed.
# HOUGE_AGY_ENV_PASSTHROUGH=

# --- Kimi API provider ---
# KIMI_API_KEY=
# Base URL for the OpenAI-compatible endpoint. Default: https://api.moonshot.ai
# HOUGE_KIMI_BASE_URL=https://api.moonshot.ai

# --- Gemini API provider (Google OpenAI-compat endpoint) ---
# GEMINI_API_KEY=
# Base URL. Default: https://generativelanguage.googleapis.com/v1beta/openai
# HOUGE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Output budget. Generous because 3.5-flash spends "thinking" tokens against the
# same budget — a tight cap can starve the visible answer. Default: 8192.
# HOUGE_GEMINI_MAX_TOKENS=8192

# Policy: single-shot, tools-disabled, env-allowlisted, killable CLI inference
# (pi) is classified `external_read` and allowed ungated. Full agentic
# coding_agent_cli delegation (tools enabled) remains denied until V2
# containment. Rationale: docs/decisions/0002-pi-as-agent-runtime.md
# Full parameter docs: docs/reference/configuration.md

# --- Web read (powers /research; Tier-1, ADR 0006) ---
# Pluggable web-provider chain (like the LLM chain): first ok wins, fallthrough on
# unavailable/error. Known providers: tavily, firecrawl. Default: tavily,firecrawl.
# Free tiers (recurring, no card): Tavily 1,000 credits/mo, Firecrawl 1,000/mo.
# HOUGE_WEB_PROVIDERS=tavily,firecrawl
# TAVILY_API_KEY=          # tavily.com — free, no credit card
# FIRECRAWL_API_KEY=       # firecrawl.dev — free, no credit card
# HOUGE_WEB_MAX_RESULTS=5  # results per search (bounds tokens + breaker exposure)
# HOUGE_WEB_TIMEOUT_MS=    # per-provider request timeout (default tavily 20s / firecrawl 30s)
# HOUGE_TAVILY_BASE_URL=https://api.tavily.com
# HOUGE_FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# --- Direct URL read (http_fetch loop tool; Phase 3.6 step ③) ---
# Fetch ONE public URL as an inner-loop tool (GET/HEAD only, redirects never
# followed). The SSRF floor is code-owned and NOT configurable: private/reserved
# IPs always refused (resolve-and-pin), credentials-in-URL refused, byte cap on
# the DECOMPRESSED body. DEFAULT OFF — arm explicitly (armed-listing, like
# HOUGE_SELFWRITE_ENABLED). Accepts 1/true/yes/on.
# HOUGE_HTTPFETCH_ENABLED=true
# Wall-clock cap per fetch (ms; bounds the whole body read). Default 15000.
# HOUGE_HTTPFETCH_TIMEOUT_MS=15000
# Byte cap on the DECOMPRESSED body (zip-bomb guard). Default 1000000.
# HOUGE_HTTPFETCH_MAX_BYTES=1000000
# Optional comma-separated host denylist, punycode form; each entry matches the
# exact host and every subdomain (dot-suffix), e.g. evil.test blocks a.evil.test.
# HOUGE_HTTPFETCH_DENY=

# --- Secrets firewall (ADR 0015, Phase 1) ---
# When armed, the five secrets (KIMI/GEMINI/TAVILY/FIRECRAWL API keys + the
# Telegram bot token) are lifted into an in-process broker at boot and then
# DELETED from process.env — the daemon holds no ambient credential, so a
# self-written env-reader gets nothing. Also masks any secret VALUE in outbound
# chat/ledger/error text. DEFAULT OFF — arm explicitly (accepts 1/true/yes/on)
# once you've confirmed the strip doesn't starve a live provider.
# HOUGE_SECRETS_FIREWALL_ENABLED=true
# Optional escape hatch: extra env var names (comma-separated) the Codex child is
# allowed to inherit, on top of the PATH/HOME/TERM/LANG/USER allowlist.
# HOUGE_CODEX_ENV_PASSTHROUGH=

# --- Code self-write reviewer (checker 3) ---
# Which agent runs the independent adversarial diff reviewer. Default: kimi
# (cheap + model-diverse from the Codex writer; the free test-gate + your merge
# are the real safety net).
#   kimi   — local kimi-cli agent, DEFAULT (requires HOUGE_KIMI_CLI_BIN)
#   claude — Claude CLI reviewer (requires HOUGE_CLAUDE_BIN, absolute path)
#   codex  — independent Codex session fallback (requires HOUGE_CODEX_BIN)
# HOUGE_SELFWRITE_REVIEWER=kimi

# Kimi CLI reviewer (the default). Absolute path to the `kimi-cli` binary —
# REQUIRED for the daemon (restricted PATH lacks ~/.local/bin), like
# HOUGE_CLAUDE_BIN/HOUGE_CODEX_BIN. Unset = kimi reviewer disabled (clean error,
# no publish). Invoked headless with the prompt on stdin, pinned to a generated
# NO-TOOLS agent (tools: []) so a prompt-injected diff can't make the reviewer
# read/write the host — the analogue of claude's tools-denied / codex read-only:
#   kimi-cli --print --quiet --final-message-only --input-format text --agent-file <no-tools>
# HOUGE_KIMI_CLI_BIN=/Users/you/.local/bin/kimi-cli
# Optional model override (passed as --model <m>). Unset = kimi-cli's own default
# (kimi-for-coding).
# HOUGE_KIMI_CLI_MODEL=kimi-for-coding
# Per-attempt wall-clock timeout (ms). Default 180000; a normal review returns ~7s.
# HOUGE_KIMI_CLI_TIMEOUT_MS=180000

# --- Global autonomy circuit-breaker ---
# Rolling-24h ceilings across ALL runs (a BREAKER, not a throttle): once a cap is
# reached, new run admissions are REFUSED with a `global_budget_fuse` ledger event
# and exactly one Telegram alert per episode; runs resume automatically as the
# window clears. Status/approve/deny are never blocked. This is the safety floor
# for the always-on daemon. Unset = built-in defaults shown below.
# HOUGE_GLOBAL_MAX_RUNS_24H=200
# HOUGE_GLOBAL_MAX_TOOL_CALLS_24H=1000
# HOUGE_GLOBAL_MAX_GATED_ATTEMPTS_24H=100
