# Houge configuration — copy to `.env` and fill in.
#   cp .env.example .env
#
# `.env` is gitignored. Real environment variables (e.g. `set -x FOO bar`)
# take precedence over anything in this file.
#
# By default the CLI reads `<cwd>/.env`. To share one file across git
# worktrees, point every worktree at a single absolute path instead:
#   set -x HOUGE_ENV_FILE /Users/pluo/Projects/adventure/.env

# --- Telegram (required for `houge telegram-poll --once`) ---
# Bot token from @BotFather.
HOUGE_TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (e.g. from @userinfobot).
HOUGE_TELEGRAM_USER_ID=

# Numeric chat id. For a 1:1 chat with your bot this equals your user id.
HOUGE_TELEGRAM_CHAT_ID=

# --- LLM provider chain (powers `/ask`) ---
# Ordered, comma-separated chain with automatic fallback (first success wins;
# unavailable/error/timeout falls through to the next).
# Known providers: pi (hardened single-shot CLI), kimi-api (OpenAI-compatible
# HTTP). Default chain when unset: pi,kimi-api.
# NOTE: the singular HOUGE_LLM_PROVIDER is IGNORED when this plural is set.
# HOUGE_LLM_PROVIDERS=pi,kimi-api

# Model is configured PER PROVIDER (their model namespaces differ — there is no
# shared global, to avoid feeding e.g. a Moonshot id to pi).
#   pi:        omit to defer to pi's OWN configured provider/model (e.g. kimi-coder).
#              Only set this to make Houge override pi's choice.
# HOUGE_LLM_MODEL_PI=
#   kimi-api:  must be a model your KIMI_API_KEY can access (GET /v1/models).
#              Code fallback if unset: moonshot-v1-auto (stable alias, won't 404).
# HOUGE_LLM_MODEL_KIMI=kimi-k2.7-code-highspeed

# Neutral `/ask` system prompt. `/ask` is plain question answering, so Houge
# replaces pi's default *coding-assistant* persona (and seeds the API providers'
# system message) with a neutral one. Override the whole prompt here for a
# different voice/policy. Unset = built-in neutral default.
# HOUGE_ASK_SYSTEM_PROMPT=

# Per-provider wall-clock timeouts (ms). The CapabilityRunner's enforced cap is
# DERIVED from these: sum(per-provider timeouts) + 15000 buffer. With defaults
# (pi 60000 + kimi 30000) the runner cap is 105000.
# HOUGE_LLM_TIMEOUT_MS=          # fallback for any provider without a specific one
# HOUGE_LLM_TIMEOUT_MS_PI=60000
# HOUGE_LLM_TIMEOUT_MS_KIMI=30000

# --- pi CLI provider ---
# Extra env var NAMES (comma-separated) to pass through to the pi child process.
# The child runs with a minimal allowlist (PATH, HOME, TERM, LANG, USER) — the
# attacker-controlled question never sees the Telegram token or unrelated keys.
# Add the var pi needs for auth here, e.g. the provider API key pi is set up for.
# HOUGE_PI_ENV_PASSTHROUGH=

# --- Kimi API provider ---
# KIMI_API_KEY=
# Base URL for the OpenAI-compatible endpoint. Default: https://api.moonshot.ai
# HOUGE_KIMI_BASE_URL=https://api.moonshot.ai

# Policy: single-shot, tools-disabled, env-allowlisted, killable CLI inference
# (pi) is classified `external_read` and allowed ungated. Full agentic
# coding_agent_cli delegation (tools enabled) remains denied until V2
# containment. Rationale: docs/decisions/0002-pi-as-agent-runtime.md
# Full parameter docs: docs/reference/configuration.md

# --- Global autonomy circuit-breaker ---
# Rolling-24h ceilings across ALL runs (a BREAKER, not a throttle): once a cap is
# reached, new run admissions are REFUSED with a `global_budget_fuse` ledger event
# and exactly one Telegram alert per episode; runs resume automatically as the
# window clears. Status/approve/deny are never blocked. This is the safety floor
# for the always-on daemon. Unset = built-in defaults shown below.
# HOUGE_GLOBAL_MAX_RUNS_24H=200
# HOUGE_GLOBAL_MAX_TOOL_CALLS_24H=1000
# HOUGE_GLOBAL_MAX_GATED_ATTEMPTS_24H=100
