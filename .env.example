# Houge configuration — copy to `.env` and fill in.
#   cp .env.example .env
#
# `.env` is gitignored. Real environment variables (e.g. `set -x FOO bar`)
# take precedence over anything in this file.
#
# By default the CLI reads `<cwd>/.env`. To share one file across git
# worktrees, point every worktree at a single absolute path instead:
#   set -x HOUGE_ENV_FILE /Users/pluo/Projects/adventure/.env

# --- Telegram (required for `houge telegram-poll --once`) ---
# Bot token from @BotFather.
HOUGE_TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (e.g. from @userinfobot).
HOUGE_TELEGRAM_USER_ID=

# Numeric chat id. For a 1:1 chat with your bot this equals your user id.
HOUGE_TELEGRAM_CHAT_ID=

# --- Always-on daemon (`houge telegram-poll`, no --once) ---
# Long-poll timeout (s): how long an IDLE Telegram connection is held; a message
# arriving sooner is delivered immediately (not your message latency). Default 30.
# HOUGE_TELEGRAM_LONGPOLL_TIMEOUT_S=30
# Exponential backoff after Telegram errors: base * 2^(failures-1), capped.
# HOUGE_DAEMON_BACKOFF_BASE_MS=1000
# HOUGE_DAEMON_BACKOFF_MAX_MS=60000
# Single-instance lockfile path (a second daemon with the same lock exits).
# HOUGE_DAEMON_LOCK_PATH=houge.daemon.lock

# --- LLM runtime: omp (ADR 0028) ---
# Every LLM call runs on omp under its own profile `houge`, on subscription OAuth only.
# One-time logins (on the mini): omp --profile houge login <anthropic|google-antigravity|kimi-code|openai-codex>
# Model strings are provider/model[:effort]; a comma list is an ordered fallback chain.
# Defaults shown (src/omp/omp-config.ts). Full docs: docs/reference/configuration.md
# HOUGE_OMP_BIN=omp                  # use an absolute path for the daemon (restricted launchd PATH)
# HOUGE_OMP_PROFILE=houge
# HOUGE_OMP_SANDBOX=1                # 0 = no sandbox-exec (tests only)
# HOUGE_OMP_VERSION=18.4.4           # every spawn refuses a different `omp --version`
# HOUGE_OMP_VERSION_ALLOW=           # extra accepted versions, after re-running the live gate
# HOUGE_OMP_PLANNER=anthropic/claude-opus-5-5:medium,google-antigravity/claude-opus-4-6:medium,kimi-code/k3:low
# HOUGE_OMP_READER=google-antigravity/gemini-3.8-flash:low,kimi-code/k3:low,openai-codex/gpt-5.5:low
# HOUGE_OMP_MEDIA=google-antigravity/gemini-3.8-flash:low
# HOUGE_OMP_TICKS=kimi-code/k3:low
# HOUGE_OMP_JUDGES=kimi-code/k3,openai-codex/gpt-5.5,google-antigravity/gemini-3.1-pro
# HOUGE_OMP_CHAIR=anthropic/claude-opus-5-5:low
# HOUGE_OMP_REVIEWER=kimi-code/k3:high,google-antigravity/claude-opus-4-6:medium
# HOUGE_OMP_ENV_PASSTHROUGH=KIMI_CODE_OAUTH_HOST,KIMI_CODE_BASE_URL   # env NAMES for omp children; never a secret
# HOUGE_OMP_TURN_TIMEOUT_MS=600000
# HOUGE_OMP_FRAME_IDLE_MS=180000
# HOUGE_OMP_APPROVAL_TIMEOUT_MS=1800000
# HOUGE_OMP_ONESHOT_TIMEOUT_MS=120000
# HOUGE_OMP_IDLE_EXIT_MS=3600000
# HOUGE_OMP_SHELL_TIMEOUT_MS=120000
# HOUGE_OMP_LEASE_TTL_S=120

# `/ask` system prompt override. Unset = composed from memory/ identity + lessons.
# HOUGE_ASK_SYSTEM_PROMPT=

# --- Voice leg: agy CLI (voice notes only; omp cannot hear audio) ---
# Absolute path to the `agy` binary. Set it for the daemon (restricted PATH).
# HOUGE_AGY_BIN=/Users/you/.local/bin/agy
# Transcription model, one of `agy models`. Pin it here: a retired pin fails every call.
# HOUGE_AGY_MODEL=Gemini 3.8 Flash (Low)
# Extra env var NAMES for the agy child (minimal allowlist otherwise; rarely needed).
# HOUGE_AGY_ENV_PASSTHROUGH=

# --- Web read (powers /research; Tier-1, ADR 0006) ---
# Pluggable web-provider chain (like the LLM chain): first ok wins, fallthrough on
# unavailable/error. Known providers: tavily, firecrawl. Default: tavily,firecrawl.
# Free tiers (recurring, no card): Tavily 1,000 credits/mo, Firecrawl 1,000/mo.
# HOUGE_WEB_PROVIDERS=tavily,firecrawl
# TAVILY_API_KEY=          # tavily.com — free, no credit card
# FIRECRAWL_API_KEY=       # firecrawl.dev — free, no credit card
# HOUGE_WEB_MAX_RESULTS=5  # results per search (bounds tokens + breaker exposure)
# HOUGE_WEB_TIMEOUT_MS=    # per-provider request timeout (default tavily 20s / firecrawl 30s)
# HOUGE_TAVILY_BASE_URL=https://api.tavily.com
# HOUGE_FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# --- Direct URL read (http_fetch loop tool; Phase 3.6 step ③) ---
# Fetch ONE public URL as an inner-loop tool (GET/HEAD only, redirects never
# followed). The SSRF floor is code-owned and NOT configurable: private/reserved
# IPs always refused (resolve-and-pin), credentials-in-URL refused, byte cap on
# the DECOMPRESSED body. DEFAULT OFF — arm explicitly (armed-listing, like
# HOUGE_SELFWRITE_ENABLED). Accepts 1/true/yes/on.
# HOUGE_HTTPFETCH_ENABLED=true
# Wall-clock cap per fetch (ms; bounds the whole body read). Default 15000.
# HOUGE_HTTPFETCH_TIMEOUT_MS=15000
# Byte cap on the DECOMPRESSED body (zip-bomb guard). Default 1000000.
# HOUGE_HTTPFETCH_MAX_BYTES=1000000
# Optional comma-separated host denylist, punycode form; each entry matches the
# exact host and every subdomain (dot-suffix), e.g. evil.test blocks a.evil.test.
# HOUGE_HTTPFETCH_DENY=

# --- Secrets firewall (ADR 0015, Phase 1) ---
# When armed, the broker secrets (TAVILY/FIRECRAWL API keys, the Telegram bot token,
# the Gmail pair, TYPESAFE_API_KEY) are lifted into an in-process broker at boot and then
# DELETED from process.env — the daemon holds no ambient credential, so a
# self-written env-reader gets nothing. Also masks any secret VALUE in outbound
# chat/ledger/error text. DEFAULT OFF — arm explicitly (accepts 1/true/yes/on)
# once you've confirmed the strip doesn't starve a live provider.
# HOUGE_SECRETS_FIREWALL_ENABLED=true
# Optional escape hatch: extra env var names (comma-separated) the Codex child is
# allowed to inherit, on top of the PATH/HOME/TERM/LANG/USER allowlist.
# HOUGE_CODEX_ENV_PASSTHROUGH=

# --- Dual-LLM privilege separation (ADR 0014) ---
# No variables since the omp cutover: the quarantined reader (HOUGE_OMP_READER) always
# reads web_search / http_fetch / gmail_read / google_api output; the planner never sees
# those raw bytes. bash output is exempt (ADR 0028 D12).

# --- Deterministic timezone tool (to_local_time) ---
# A trusted, zero-dep loop tool that converts source datetimes (each with its stated
# timezone) into Houge's local timezone plus a today/tomorrow/day-N label — computed in
# CODE, so he stops guessing date frames across the dateline (the recurring 时区/赛程混).
# The model batches all times into ONE call; the harness does the Intl arithmetic.
# DEFAULT OFF — arm explicitly (accepts 1/true/yes/on). OFF ⇒ tool unlisted, loop unchanged.
# HOUGE_TIME_TOOL_ENABLED=true
# Override Houge's local timezone (IANA name). Unset ⇒ the runtime timezone (the daemon's,
# e.g. Australia/Sydney). Used to resolve "today/tomorrow" for the converter.
# HOUGE_TIMEZONE=Australia/Sydney

# --- Code self-write reviewer (checker 3) ---
# Which agent runs the independent adversarial diff reviewer. Default: omp
#   omp    — a tool-less omp one-shot on HOUGE_OMP_REVIEWER, DEFAULT
#   codex  — an independent Codex session (requires HOUGE_CODEX_BIN)
# Stale values (kimi, claude) fall back to omp.
# HOUGE_SELFWRITE_REVIEWER=omp

# --- Global autonomy circuit-breaker ---
# Rolling-24h ceilings across ALL runs (a BREAKER, not a throttle): once a cap is
# reached, new run admissions are REFUSED with a `global_budget_fuse` ledger event
# and exactly one Telegram alert per episode; runs resume automatically as the
# window clears. Status/approve/deny are never blocked. This is the safety floor
# for the always-on daemon. Unset = built-in defaults shown below.
# HOUGE_GLOBAL_MAX_RUNS_24H=200
# HOUGE_GLOBAL_MAX_TOOL_CALLS_24H=1000
# After the omp cutover set 3000 (3x): every bridge call incl. bash and every fs_write
# now writes a tool_finished row. Re-tune from the first week's numbers.
# HOUGE_GLOBAL_MAX_TOOL_CALLS_24H=3000
# HOUGE_GLOBAL_MAX_GATED_ATTEMPTS_24H=100

# --- Metered-API $ ceiling (ADR 0019) ---
# DORMANT since the omp cutover: no metered leg exists. Kept for a future metered leg.
# Dollar ceilings for the pay-per-token legs (kimi-api/gemini-api), derived from priced
# `llm_call` ledger events. On breach the metered legs are dropped from every chain
# (flat-rate pi/agy-cli keep working) + ONE deduped Telegram alert per episode.
# HOUGE_METERED_DAILY_USD=5        # rolling 24h window; 0 = metered legs always off
# HOUGE_METERED_MONTHLY_USD=50     # calendar month (UTC) — how the invoice resets
# Price overrides: JSON of model-id PREFIX -> USD per Mtok, merged over the seed table
# (src/llm/metered-pricing.ts; longest prefix wins). Unpriced metered models log once
# and their spend is INVISIBLE to the ceiling until priced here.
# HOUGE_METERED_PRICES_JSON={"kimi-":{"input_usd_per_mtok":0.6,"output_usd_per_mtok":2.5,"cached_input_usd_per_mtok":0.15}}

# --- Kill switch + disarm posture (ADR 0018) ---
# /kill writes the tombstone; the boot gate then PARKS the daemon (launchd KeepAlive
# relaunches an idle process, never a live agent) until you delete the file and restart.
# HOUGE_TOMBSTONE_PATH=houge.kill
# /disarm posture file — forces the evolution/scheduler flags to false, live AND across
# restarts (applied BEFORE this .env is read, so it outranks it). NOTE: if you move it,
# set HOUGE_DISARM_PATH as a REAL env var (shell/launchd plist), not here.
# HOUGE_DISARM_PATH=houge.disarm

# Scheduler (ADR 0017) — recurring/one-time tasks fired from the daemon loop.
# HOUGE_SCHEDULER_ENABLED=true
# HOUGE_SCHEDULER_MAX_PER_CHAT=10

# Episodic memory (Phase M, ADR 0016) — local Ollama embeddings, FTS5 fallback.
# HOUGE_EPISODIC_ENABLED=true
# HOUGE_EMBED_URL=http://localhost:11434
# HOUGE_EMBED_MODEL=embeddinggemma
# HOUGE_EMBED_TIMEOUT_MS=5000

# LLM wiki (Phase W, ADR 0020) — durable knowledge pages built from the turn's fetched
# sources, cross-source verified; sqlite is truth, memory/wiki/<slug>.md is the render.
# W2 closes the reuse loop: retrieval folds pages into the prompt, ratings feed
# reuse_value, and a daily decay tick forgets what stops being used.
# HOUGE_WIKI_ENABLED=true
# HOUGE_WIKI_MIN_SOURCES=2       # distinct source URLs required this turn before a save
# HOUGE_WIKI_VERIFY_PASSES=2     # cross-source verify ensemble size (mean confidence)
# HOUGE_WIKI_MAX_PAGES=200       # global active-page cap; overflow prunes lowest reuse
# HOUGE_WIKI_RETRIEVE_CAP=1      # max pages folded into one prompt (W2 retrieval)
# HOUGE_WIKI_RECENCY_HALFLIFE_DAYS=30  # retrieval recency half-life (max of verified/used)
# HOUGE_WIKI_DECAY_DAYS=45       # unused for this long → −20% reuse/day-tick, prune below the line
#                                 # (the prune line itself is HOUGE_LESSON_PRUNE_THRESHOLD — shared with lessons)

# DB backup (ADR 0021) — WAL-safe periodic snapshot of houge.sqlite (VACUUM INTO →
# backups/, integrity-checked, tmp+rename). LOCAL-ONLY: protects against corruption
# and accidental deletes, NOT disk death. DEFAULT OFF — arm explicitly (1/true/yes/on).
# Restore runbook: README § Backup & restore.
# HOUGE_BACKUP_ENABLED=true
# HOUGE_BACKUP_INTERVAL_HOURS=24 # hours between snapshots (>0; garbage → default)
# HOUGE_BACKUP_KEEP=7            # newest snapshots kept; older ones unlinked (min 1)
